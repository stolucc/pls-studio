{
  "name": "pls-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "validate:generate": "Rscript scripts/validation/generate.R",
    "test:server": "cd server && npm test",
    "server": "cd server && npm run dev",
    "test:webr": "WEBR_TESTS=1 vitest run webr.test",
    "webr:fetch": "node scripts/webr/fetch.mjs",
    "prebuild": "node scripts/webr/fetch.mjs --if-missing"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webr": "0.6.0",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.33",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.8",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
