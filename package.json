{
  "name": "pls-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "validate:generate": "Rscript scripts/validation/generate.R",
    "test:server": "cd server && npm test",
    "server": "cd server && npm run dev",
    "test:webr": "WEBR_TESTS=1 vitest run webr.test",
    "test:native": "WEBR_TESTS=1 PS_NATIVE_R=1 vitest run webr.test",
    "test:webr:all": "WEBR_TESTS=1 WEBR_SLOW=1 vitest run webr.test",
    "validate:evidence": "rm -rf .validation && PS_VALIDATION_DIR=.validation WEBR_TESTS=1 WEBR_SLOW=1 vitest run webr.test; node scripts/validation/evidence.mjs .validation",
    "webr:fetch": "node scripts/webr/fetch.mjs",
    "prebuild": "node scripts/webr/fetch.mjs --if-missing && node scripts/architecture.mjs",
    "docs:architecture": "node scripts/architecture.mjs",
    "notices": "node scripts/notices.mjs",
    "data:fetch": "node scripts/validation/fetch_example_data.mjs",
    "test:mutation": "stryker run",
    "test:mutation:engine": "stryker run stryker.engine.config.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "jspdf": "4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "2.8.1",
    "webr": "0.6.0",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.33",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "5.8",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "license": "GPL-2.0-or-later",
  "overrides": {
    "qs": "^6.17.1"
  }
}
