  "Beta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Beta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="on" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">b1</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">b2</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Hexagon (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</