ator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
}
`;

