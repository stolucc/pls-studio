  "Delta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Delta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox"><span><b>Observed covariate</b><br><span class="hint">Treat d1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label><div class="field" style="margin-top: 8px;"><label>Reliability of d1</label><input class="input num" min="0.01" max="1" step="0.01" placeholder="1 (no measurement error)" type="number" value="0.9"><div class="hint">A known reliability (e.g. a published α) fixes the error variance at (1 − reliability) × the indicator’s variance (Bollen 1989). Empty: the error variance is 0. R engine (lavaan).</div></div></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">d1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove d1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Epsilon": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Epsilon"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox" checked=""><span><b>Observed covariate</b><br><span class="hint">Treat e1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">e1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove e1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div></div><div class="section"><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Gamma": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Gamma"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><div class="hint" style="margin-bottom: 6px;">Higher-order factor: measured by other constructs (the first is the marker).</div><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Alpha</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Beta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Delta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Lambda</label></div><div class="section"><div class="section-title">Components (2)</div><div class="ind" style="align-items: center;"><span>Alpha</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Alpha" style="width: 90px;" type="number" value=""></div><div class="ind" style="align-items: center;"><span>Beta</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Beta" style="width: 90px;" type="number" value="1"></div><div class="hint">A value holds that loading (the first component sets the scale with 1 unless given a value). A latent curve model: intercept 1, 1, 1, … and slope 0, 1, 2, … over the waves as components.</div><label class="check" style="margin-top: 6px;"><input type="checkbox" checked=""><span>Estimate the first loading too<br><span class="hint">The scale then comes from a path into Gamma held at a value (right-click the path → Hold at a value), e.g. a formative construct scaled by one of its causes (Brown 2015, Table 8.12).</span></span></label><div class="ind-list"></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Lambda": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Lambda"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
}
`;

exports[`Inspector markup > every construct, cbsem 2sls 1`] = `
{
  "Alpha": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Alpha"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (3)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a3</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a3"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Beta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Beta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="on" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">b1</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">b2</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Hexagon (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Delta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Delta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox"><span><b>Observed covariate</b><br><span class="hint">Treat d1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label><div class="field" style="margin-top: 8px;"><label>Reliability of d1</label><input class="input num" min="0.01" max="1" step="0.01" placeholder="1 (no measurement error)" type="number" value="0.9"><div class="hint">A known reliability (e.g. a published α) fixes the error variance at (1 − reliability) × the indicator’s variance (Bollen 1989). Empty: the error variance is 0. R engine (lavaan).</div></div></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">d1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove d1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Epsilon": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Epsilon"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox" checked=""><span><b>Observed covariate</b><br><span class="hint">Treat e1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">e1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove e1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div></div><div class="section"><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Gamma": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Gamma"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><div class="hint" style="margin-bottom: 6px;">Higher-order factor: measured by other constructs (the first is the marker).</div><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Alpha</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Beta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Delta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Lambda</label></div><div class="section"><div class="section-title">Components (2)</div><div class="ind" style="align-items: center;"><span>Alpha</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Alpha" style="width: 90px;" type="number" value=""></div><div class="ind" style="align-items: center;"><span>Beta</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Beta" style="width: 90px;" type="number" value="1"></div><div class="hint">A value holds that loading (the first component sets the scale with 1 unless given a value). A latent curve model: intercept 1, 1, 1, … and slope 0, 1, 2, … over the waves as components.</div><label class="check" style="margin-top: 6px;"><input type="checkbox" checked=""><span>Estimate the first loading too<br><span class="hint">The scale then comes from a path into Gamma held at a value (right-click the path → Hold at a value), e.g. a formative construct scaled by one of its causes (Brown 2015, Table 8.12).</span></span></label><div class="ind-list"></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Lambda": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Lambda"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
}
`;

exports[`Inspector markup > every construct, cbsem mi amelia 1`] = `
{
  "Alpha": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Alpha"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (3)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a3</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a3"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Beta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Beta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="on" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">b1</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">b2</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Hexagon (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Delta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Delta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox"><span><b>Observed covariate</b><br><span class="hint">Treat d1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label><div class="field" style="margin-top: 8px;"><label>Reliability of d1</label><input class="input num" min="0.01" max="1" step="0.01" placeholder="1 (no measurement error)" type="number" value="0.9"><div class="hint">A known reliability (e.g. a published α) fixes the error variance at (1 − reliability) × the indicator’s variance (Bollen 1989). Empty: the error variance is 0. R engine (lavaan).</div></div></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">d1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove d1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Epsilon": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Epsilon"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox" checked=""><span><b>Observed covariate</b><br><span class="hint">Treat e1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">e1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove e1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div></div><div class="section"><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Gamma": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Gamma"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><div class="hint" style="margin-bottom: 6px;">Higher-order factor: measured by other constructs (the first is the marker).</div><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Alpha</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Beta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Delta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Lambda</label></div><div class="section"><div class="section-title">Components (2)</div><div class="ind" style="align-items: center;"><span>Alpha</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Alpha" style="width: 90px;" type="number" value=""></div><div class="ind" style="align-items: center;"><span>Beta</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Beta" style="width: 90px;" type="number" value="1"></div><div class="hint">A value holds that loading (the first component sets the scale with 1 unless given a value). A latent curve model: intercept 1, 1, 1, … and slope 0, 1, 2, … over the waves as components.</div><label class="check" style="margin-top: 6px;"><input type="checkbox" checked=""><span>Estimate the first loading too<br><span class="hint">The scale then comes from a path into Gamma held at a value (right-click the path → Hold at a value), e.g. a formative construct scaled by one of its causes (Brown 2015, Table 8.12).</span></span></label><div class="ind-list"></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Lambda": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Lambda"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
}
`;

exports[`Inspector markup > every construct, cbsem wlsmv twostage 1`] = `
{
  "Alpha": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Alpha"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (3)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a3</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a3"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Beta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Beta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="on" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">b1</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">b2</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Hexagon (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Delta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Delta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox"><span><b>Observed covariate</b><br><span class="hint">Treat d1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label><div class="field" style="margin-top: 8px;"><label>Reliability of d1</label><input class="input num" min="0.01" max="1" step="0.01" placeholder="1 (no measurement error)" type="number" value="0.9"><div class="hint">A known reliability (e.g. a published α) fixes the error variance at (1 − reliability) × the indicator’s variance (Bollen 1989). Empty: the error variance is 0. R engine (lavaan).</div></div></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">d1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove d1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Epsilon": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Epsilon"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><label class="check"><input type="checkbox" checked=""><span><b>Observed covariate</b><br><span class="hint">Treat e1 as an observed exogenous variable: its (co)variances are fixed at the sample values and it is not correlated with latent variables (lavaan’s fixed.x). Drawn as a rectangle.</span></span></label></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">e1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove e1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div></div><div class="section"><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Gamma": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Gamma"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">CB-SEM</div><div class="hint" style="margin-bottom: 6px;">Higher-order factor: measured by other constructs (the first is the marker).</div><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Alpha</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Beta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Delta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Lambda</label></div><div class="section"><div class="section-title">Components (2)</div><div class="ind" style="align-items: center;"><span>Alpha</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Alpha" style="width: 90px;" type="number" value=""></div><div class="ind" style="align-items: center;"><span>Beta</span><input class="input num" step="any" placeholder="estimated" aria-label="Loading of Beta" style="width: 90px;" type="number" value="1"></div><div class="hint">A value holds that loading (the first component sets the scale with 1 unless given a value). A latent curve model: intercept 1, 1, 1, … and slope 0, 1, 2, … over the waves as components.</div><label class="check" style="margin-top: 6px;"><input type="checkbox" checked=""><span>Estimate the first loading too<br><span class="hint">The scale then comes from a path into Gamma held at a value (right-click the path → Hold at a value), e.g. a formative construct scaled by one of its causes (Brown 2015, Table 8.12).</span></span></label><div class="ind-list"></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Lambda": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Lambda"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: an exact weighted sum of its indicators, which covary freely (lavaan’s composites; hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
}
`;

exports[`Inspector markup > every construct, pls 1`] = `
{
  "Alpha": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Alpha"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: a weighted combination of its indicators (hexagon)">Composite</button></div></div><div class="field"><label title="How this construct's indicator weights are estimated (each construct has its own mode)">Outer weights (this construct)</label><div class="segmented"><button class="on">Mode A (correlation)</button><button class="">Mode B (regression)</button><button class="" title="Equal weights on the standardised indicators (unit weights)">Sum scores</button><button class="" title="Weights you give, not estimated; rescaled so that the score has unit variance. Runs in the built-in engine">Pre-defined</button></div></div><div class="field"><label>Dominant indicator</label><select class="select"><option value="">None (sign as estimated)</option><option value="a1">a1</option><option value="a2">a2</option><option value="a3">a3</option></select><div class="hint" style="margin-top: 4px;">Fixes the construct’s sign: its scores point the way this indicator does (loading positive), in the estimate and every bootstrap draw. cSEM and the built-in engine.</div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (3)</div><div class="ind-list"><div class="ind"><span class="vname">a1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a2</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">a3</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove a3"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Beta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Beta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="on" title="Emergent variable: a weighted combination of its indicators (hexagon)">Composite</button></div></div><div class="field"><label title="How this construct's indicator weights are estimated (each construct has its own mode)">Outer weights (this construct)</label><div class="segmented"><button class="">Mode A (correlation)</button><button class="">Mode B (regression)</button><button class="" title="Equal weights on the standardised indicators (unit weights)">Sum scores</button><button class="on" title="Weights you give, not estimated; rescaled so that the score has unit variance. Runs in the built-in engine">Pre-defined</button></div><label class="row2" style="align-items: center; margin-top: 4px;">b1<input class="input num" step="0.1" type="number" value="1"></label><label class="row2" style="align-items: center; margin-top: 4px;">b2<input class="input num" step="0.1" type="number" value="0.5"></label></div><div class="field"><label>Dominant indicator</label><select class="select"><option value="">None (sign as estimated)</option><option value="b1">b1</option><option value="b2">b2</option></select><div class="hint" style="margin-top: 4px;">Fixes the construct’s sign: its scores point the way this indicator does (loading positive), in the estimate and every bootstrap draw. cSEM and the built-in engine.</div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (2)</div><div class="ind-list"><div class="ind"><span class="vname">b1</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div><div class="ind"><span class="vname">b2</span><span class="num muted" title="Weight"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove b2"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Hexagon (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Delta": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Delta"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: a weighted combination of its indicators (hexagon)">Composite</button></div></div><div class="field"><label title="How this construct's indicator weights are estimated (each construct has its own mode)">Outer weights (this construct)</label><div class="segmented"><button class="on">Mode A (correlation)</button><button class="">Mode B (regression)</button><button class="" title="Equal weights on the standardised indicators (unit weights)">Sum scores</button><button class="" title="Weights you give, not estimated; rescaled so that the score has unit variance. Runs in the built-in engine">Pre-defined</button></div></div><label class="check"><input type="checkbox" checked=""><span><b>Categorical</b><br><span class="hint">d1’s k categories become k − 1 dummy variables (the first category is the reference) forming a composite (Mode B): the effect of group membership (Henseler 2021). Exogenous only.</span></span></label><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">d1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove d1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div><div class="add-indicator"><div class="row2"><input class="input" placeholder="Add an indicator by name" aria-label="Indicator name" maxlength="64" value=""><button class="btn" disabled="">Add</button></div></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Epsilon": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Epsilon"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: a weighted combination of its indicators (hexagon)">Composite</button></div></div><div class="field"><label title="How this construct's indicator weights are estimated (each construct has its own mode)">Outer weights (this construct)</label><div class="segmented"><button class="on">Mode A (correlation)</button><button class="">Mode B (regression)</button><button class="" title="Equal weights on the standardised indicators (unit weights)">Sum scores</button><button class="" title="Weights you give, not estimated; rescaled so that the score has unit variance. Runs in the built-in engine">Pre-defined</button></div></div><label class="check"><input type="checkbox"><span><b>Categorical</b><br><span class="hint">e1’s k categories become k − 1 dummy variables (the first category is the reference) forming a composite (Mode B): the effect of group membership (Henseler 2021). Exogenous only.</span></span></label><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Indicators (1)</div><div class="ind-list"><div class="ind"><span class="vname">e1</span><span class="num muted" title="Loading"></span><button class="btn icon ghost sm" style="width: 24px; height: 24px;" aria-label="Remove e1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button></div></div></div><div class="section"><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Gamma": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Gamma"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: a weighted combination of its indicators (hexagon)">Composite</button></div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" aria-label="Indicators on the top" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 3h12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the right" aria-label="Indicators on the right" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M21 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the bottom" aria-label="Indicators on the bottom" aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M6 21h12" stroke-width="3"></path></svg></button></div></div></div><div class="section"><div class="section-title">Second-order construct</div><div class="hint" style="margin-bottom: 6px;">Measured by first-order constructs (two-stage approach): their scores are its indicators in stage 2. cSEM weights a common factor by Mode A and corrects it for attenuation. The components stay out of the structural model; connect this construct instead.</div><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Alpha</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox" checked="">Beta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Delta</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Epsilon</label><label class="check" style="margin-bottom: 4px;"><input type="checkbox">Lambda</label></div><div class="section"><div class="section-title">Components (2)</div><div class="ind" style="align-items: center;"><span>Alpha</span></div><div class="ind" style="align-items: center;"><span>Beta</span></div><div class="ind-list"></div></div><div class="section"><div class="field"><label>Drawn as</label><div class="row2"><select class="select" aria-label="Shape"><option value="">Oval or circle (its type)</option><option value="rectangle">Rectangle</option><option value="octagon">Octagon</option></select><span style="display: flex; gap: 6px; align-items: center;"><input aria-label="Colour" type="color" value="#ffffff"></span></div></div><button class="btn danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"></path><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path></svg> Delete construct</button></div></div></aside>",
  "Lambda": "<aside class="panel right" aria-label="Inspector"><div class="panel-head"><span>Construct</span></div><div class="panel-body"><div class="section"><div class="field"><label>Name</label><input class="input" maxlength="100" value="Lambda"></div><div class="field"><label>Construct type</label><div class="segmented"><button class="on" title="Latent variable: indicators reflect the construct (ellipse)">Common factor</button><button class="" title="Emergent variable: a weighted combination of its indicators (hexagon)">Composite</button></div></div><div class="field"><label title="How this construct's indicator weights are estimated (each construct has its own mode)">Outer weights (this construct)</label><div class="segmented"><button class="on">Mode A (correlation)</button><button class="">Mode B (regression)</button><button class="" title="Equal weights on the standardised indicators (unit weights)">Sum scores</button><button class="" title="Weights you give, not estimated; rescaled so that the score has unit variance. Runs in the built-in engine">Pre-defined</button></div></div><div class="field"><label>Dominant indicator</label><select class="select"><option value="">None (sign as estimated)</option><option value="a1">a1</option><option value="a2">a2</option></select><div class="hint" style="margin-top: 4px;">Fixes the construct’s sign: its scores point the way this indicator does (loading positive), in the estimate and every bootstrap draw. cSEM and the built-in engine.</div></div><div class="field"><label>Indicator side</label><div class="segmented"><button class="on" title="Indicators on the left" aria-label="Indicators on the left" aria-pressed="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2.5"></rect><path d="M3 6v12" stroke-width="3"></path></svg></button><button class="" title="Indicators on the top" ar